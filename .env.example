# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Session / auth
AUTH_SECRET=

# Database (Neon PostgreSQL)
DATABASE_URL=

# Cache / rate limit (Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Object storage (Cloudflare R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
# Optional; defaults to https://{R2_ACCOUNT_ID}.r2.cloudflarestorage.com
R2_ENDPOINT=

# Email (Resend adapter)
EMAIL_FROM=
RESEND_API_KEY=

# Dev/test seed only (never commit real passwords)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Payments (ArCa / Idram) ---
ARCA_TEST_MODE=true
ARCA_BANK=idbank
ARCA_USERNAME=
ARCA_PASSWORD=
ARCA_LIVE_USERNAME=
ARCA_LIVE_PASSWORD=

IDRAM_TEST_MODE=true
IDRAM_DEV_MOCK=false
IDRAM_GET_PAYMENT_URL=https://banking.idram.am/Payment/GetPayment
IDRAM_REC_ACCOUNT=
IDRAM_SECRET_KEY=
IDRAM_LIVE_REC_ACCOUNT=
IDRAM_LIVE_SECRET_KEY=

# Pending ArCa reconciliation. Cron: GET /api/v1/cron/reconcile-payments
CRON_SECRET=
PAYMENT_RECONCILE_INTERVAL_MINUTES=5
PAYMENT_PENDING_TIMEOUT_MINUTES=60
